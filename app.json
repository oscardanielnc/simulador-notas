    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "73a8b04d-5e07-4440-b726-48cb640b6f08"
      }
    },
    "owner": "oscardanieldev",
    "icon": "./assets/icon.png"
