    "slug": "simulador-notas",
    "scheme": "simuladornotas",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "dev.oscarnavarro.simuladornotas",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#534AB7"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
