{
  "expo": {
    "name": "Mis notas",
    "slug": "simulador-notas",
    "scheme": "simuladornotas",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": { "backgroundColor": "#FFFFFF" },
    "android": {
      "package": "dev.oscarnavarro.simuladornotas",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      ["expo-splash-screen", { "backgroundColor": "#FFFFFF" }]
    ],
    "experiments": { "typedRoutes": true }
  }
}
