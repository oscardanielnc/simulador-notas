{
  "name": "simulador-notas",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "pnpm lint && pnpm typecheck && pnpm test && node scripts/check-unicode.mjs --all",
    "build:apk": "eas build -p android --profile personal --non-interactive",
    "prepare": "husky"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts?(x)"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ]
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,json,md,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "expo": "~57.0.31",
    "expo-constants": "~57.0.22",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.29",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "~57.0.16",
    "eslint": "^10.13.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "test-renderer": "~1.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
